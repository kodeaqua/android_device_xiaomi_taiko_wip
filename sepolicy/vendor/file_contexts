# Xiaomi Redmi Pad 2 (taiko) - device file_contexts
#
# Only entries that the AOSP core policy and device/mediatek/sepolicy_vndr
# (lineage-23.2 base/vendor/file_contexts) do NOT already cover. Everything
# else - and every runtime denial - is worked out on-device with
# `dmesg | grep 'avc: denied'` and audit2allow during bring-up.

# --- keystore: mitee, keymint AIDL v4 -----------------------------------------
# mtk base labels only ...keymint@3.0-service.mitee ; the taiko blob is @4.0.
/(vendor|system/vendor)/bin/hw/android\.hardware\.security\.keymint@4\.0-service\.mitee    u:object_r:hal_keymint_default_exec:s0

# --- lights: MediaTek AIDL --------------------------------------------------
# NOT labeled here: device/mediatek/sepolicy_vndr/base/vendor/file_contexts
# already maps android.hardware.lights-service.mediatek -> mtk_hal_light_exec
# (full mtk_hal_light domain in base/vendor/mtk_hal_light.te). Re-labeling it
# hal_light_default_exec is a "Multiple different specifications" hard error.

# --- dumpstate: Xiaomi -------------------------------------------------------
/(vendor|system/vendor)/bin/hw/android\.hardware\.dumpstate-service\.xiaomi                u:object_r:hal_dumpstate_default_exec:s0

# --- Xiaomi thermal daemon (blob: /vendor/bin/mi_thermald) ------------------
# domain + exec_type defined in mi_thermald.te
/(vendor|system/vendor)/bin/mi_thermald                                                    u:object_r:mi_thermald_exec:s0

# --- Display feature sysfs (Xiaomi mi_display) -----------------------------
/sys/devices/virtual/mi_display/disp_feature/disp-DSI-+[0-1](/.*)?                          u:object_r:vendor_sysfs_displayfeature:s0

# --- Touch double-tap gesture node ---------------------------------------
/sys/devices/virtual/touch/touch_dev/gesture_double_tap_state                              u:object_r:sysfs_tp_gesture:s0
