     Device framework compatibility matrix for Xiaomi Redmi Pad 2 (taiko).

     checkvintf "check-compat" (OTA-time, FCM level 202504+) rejects any
     instance that is in the device manifest but not covered by a framework
     compatibility matrix. The stock manifest.xml plus the blob vintf fragments
     (vendor/etc/vintf/manifest/*.xml) advertise the proprietary Xiaomi and
     Dolby vendor-extension HALs below, none of which live in the AOSP or
     MediaTek framework matrices. They are all optional device-specific HALs;
     listing them here lets the OTA VINTF check pass without weakening the
     shared matrices.

     vendor.mediatek.hardware.mtkpower / IMtkPowerService is in
     hardware/mediatek/vintf/mediatek_framework_compatibility_matrix.xml but
     only at version "1 to 2", while power-mediatek.xml (blob) advertises
     version 3; the entry below widens the accepted range to "1 to 3".
-->
<compatibility-matrix version="1.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.mediatek.hardware.mtkpower</name>
        <version>1-3</version>
        <interface>
            <name>IMtkPowerService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dms</name>
        <version>1</version>
        <interface>
            <name>IDms</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.aidl.mtdservice</name>
